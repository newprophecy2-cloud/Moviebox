# Render & Production Runtime Configuration
NODE_ENV=production
PORT=10000
PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com

# Stream Delivery & Proxy Signing
DEFAULT_STREAM_DELIVERY=proxy
PROXY_TOKEN_SECRET=CHANGE_ME
PROXY_TOKEN_TTL_SECONDS=900
STREAM_PROXY_TIMEOUT_MS=30000

# Strict CORS Allowlist (comma-separated allowed origins)
CORS_ORIGINS=https://YOUR-APP-DOMAIN

# Optional Persistent Database (omit in stateless mode on Render; mount persistent disk path if used)
# DATABASE_URL=/var/data/provider.sqlite

# Admin Console Authentication (required in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_RANDOM_HEX_SESSION_SECRET
ADMIN_SESSION_TTL_SECONDS=86400

# MovieBox Upstream Provider Overrides (optional; protocol defaults built in)
# MOVIEBOX_API_HOSTS=https://api6.aoneroom.com,https://api5.aoneroom.com,https://api.inmoviebox.com
# MOVIEBOX_MEDIA_HOSTS=aoneroom.com,inmoviebox.com,hakunaymatata.com
# MOVIEBOX_SIGNING_SECRET=
# MOVIEBOX_AUTH_TOKEN=
# MOVIEBOX_STREAM_REFERER=
MOVIEBOX_CACHE_TTL_MS=300000
MOVIEBOX_MOCK_MODE=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
